  <style>
    body {
      background-color: #060911;
      color: #f1f5f9;
      font-family: 'Inter', sans-serif;
    }
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0b1120;
    }
    ::-webkit-scrollbar-thumb {
      background: #1e293b;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #06b6d4;
    }
    .glass-card {
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    }
    .glow-cyan {
      box-shadow: 0 0 15px rgba(34, 211, 238, 0.25);
    }
    .glow-red {
      box-shadow: 0 0 15px rgba(239, 68, 68, 0.25);
    }
    .pulse-danger {
      animation: pulse-red 2s infinite;
    }
    @keyframes pulse-red {
      0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
      50% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
    }
    .packet-row {
      transition: all 0.2s ease;
    }
    .packet-row:hover {
      background-color: rgba(6, 182, 212, 0.1);
    }


    /* ================================================================
       THEME SYSTEM — LIGHT / DARK
       ================================================================ */
    :root {
      --theme-bg: #060911;
      --theme-surface: rgba(15, 23, 42, 0.75);
      --theme-surface-solid: #0f172a;
      --theme-surface-deep: #020617;
      --theme-text: #f1f5f9;
      --theme-text-strong: #ffffff;
      --theme-text-muted: #94a3b8;
      --theme-text-soft: #cbd5e1;
      --theme-border: #1e293b;
      --theme-border-soft: rgba(255,255,255,0.08);
      --theme-grid: rgba(255,255,255,0.05);
      --theme-hover: rgba(6,182,212,0.10);
    }

    body.theme-light {
      --theme-bg: #f4f7fb;
      --theme-surface: rgba(255,255,255,0.88);
      --theme-surface-solid: #ffffff;
      --theme-surface-deep: #eef3f8;
      --theme-text: #172033;
      --theme-text-strong: #0f172a;
      --theme-text-muted: #64748b;
      --theme-text-soft: #334155;
      --theme-border: #d7e0ea;
      --theme-border-soft: rgba(15,23,42,0.10);
      --theme-grid: rgba(15,23,42,0.08);
      --theme-hover: rgba(6,182,212,0.08);
      background: radial-gradient(circle at 15% 0%, rgba(6,182,212,.08), transparent 28%), var(--theme-bg);
      color: var(--theme-text);
    }

    body.theme-light ::selection { background: #06b6d4; color: #fff; }
    body.theme-light ::-webkit-scrollbar-track { background: #e8eef5; }
    body.theme-light ::-webkit-scrollbar-thumb { background: #c2cedb; }
    body.theme-light ::-webkit-scrollbar-thumb:hover { background: #06b6d4; }

    /* Re-theme the existing Tailwind utility-heavy UI without changing its markup. */
    body.theme-light .glass-card {
      background: var(--theme-surface);
      border-color: var(--theme-border-soft);
      box-shadow: 0 10px 30px rgba(15,23,42,.08);
    }
    body.theme-light .bg-slate-950,
    body.theme-light .bg-slate-950\/80,
    body.theme-light .bg-slate-900\/60,
    body.theme-light .bg-slate-900\/80,
    body.theme-light .bg-slate-900\/50,
    body.theme-light .bg-slate-900 {
      background-color: var(--theme-surface-deep) !important;
    }
    body.theme-light .bg-slate-800 { background-color: #e2e8f0 !important; }
    body.theme-light .bg-slate-700 { background-color: #cbd5e1 !important; }
    body.theme-light .text-white { color: var(--theme-text-strong) !important; }
    body.theme-light .text-slate-200 { color: #1e293b !important; }
    body.theme-light .text-slate-300 { color: #334155 !important; }
    body.theme-light .text-slate-400 { color: #64748b !important; }
    body.theme-light .text-slate-500 { color: #64748b !important; }
    body.theme-light .border-slate-800,
    body.theme-light .border-slate-800\/80,
    body.theme-light .border-slate-800\/60,
    body.theme-light .border-slate-700 { border-color: var(--theme-border) !important; }
    body.theme-light .divide-slate-800\/60 > :not([hidden]) ~ :not([hidden]) { border-color: var(--theme-border) !important; }
    body.theme-light .hover\\:bg-slate-800\\/50:hover,
    body.theme-light .hover\\:bg-slate-900\\/50:hover { background-color: #eaf1f7 !important; }
    body.theme-light .packet-row:hover { background-color: var(--theme-hover) !important; }

    body.theme-light header {
      background: rgba(255,255,255,.90) !important;
      border-color: var(--theme-border) !important;
    }
    body.theme-light header .bg-slate-900\/60 {
      background: rgba(241,245,249,.92) !important;
    }

    body.theme-light input,
    body.theme-light select,
    body.theme-light textarea {
      background-color: #fff !important;
      color: #172033 !important;
      border-color: #cbd5e1 !important;
    }
    body.theme-light input::placeholder { color: #94a3b8; }

    body.theme-light table thead { background: #eaf0f6 !important; }
    body.theme-light table tbody tr:hover { background: #f1f6fa !important; }

    body.theme-light .bg-cyan-500\/10 { background-color: rgba(6,182,212,.10) !important; }
    body.theme-light .bg-cyan-500\/20 { background-color: rgba(6,182,212,.14) !important; }
    body.theme-light .bg-emerald-500\/10 { background-color: rgba(16,185,129,.10) !important; }
    body.theme-light .bg-emerald-500\/20 { background-color: rgba(16,185,129,.12) !important; }
    body.theme-light .bg-rose-500\/20 { background-color: rgba(244,63,94,.10) !important; }
    body.theme-light .bg-amber-500\/20 { background-color: rgba(245,158,11,.12) !important; }
    body.theme-light .bg-purple-500\/20 { background-color: rgba(168,85,247,.10) !important; }

    body.theme-light .text-cyan-300 { color: #0891b2 !important; }
    body.theme-light .text-cyan-400 { color: #0891b2 !important; }
    body.theme-light .text-emerald-400 { color: #059669 !important; }
    body.theme-light .text-rose-400 { color: #e11d48 !important; }
    body.theme-light .text-amber-300 { color: #b45309 !important; }
    body.theme-light .text-amber-400 { color: #b45309 !important; }
    body.theme-light .text-purple-400 { color: #7e22ce !important; }

    body.theme-light .theme-toggle {
      background: #ffffff;
      color: #334155;
      border-color: #cbd5e1;
      box-shadow: 0 4px 14px rgba(15,23,42,.08);
    }
    body.theme-light .theme-toggle:hover { background: #f8fafc; }

    .theme-toggle {
      min-width: 42px;
      height: 38px;
      border: 1px solid rgba(148,163,184,.28);
      background: rgba(15,23,42,.72);
      color: #e2e8f0;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: .2s ease;
    }
    .theme-toggle:hover { transform: translateY(-1px); border-color: rgba(34,211,238,.55); }
    .theme-toggle .theme-icon { transition: transform .3s ease; }
    .theme-toggle:hover .theme-icon { transform: rotate(18deg) scale(1.08); }
    .theme-label { display:none; }
    @media (min-width: 1280px) { .theme-label { display:inline; font-size:11px; font-weight:600; } }

    /* Smooth visual transition when switching themes. */
    body, header, .glass-card, button, input, select, textarea, table, td, th {
      transition: background-color .22s ease, color .22s ease, border-color .22s ease, box-shadow .22s ease;
    }

  </style>
</head>
<body class="min-h-screen flex flex-col overflow-x-hidden selection:bg-cyber-accent selection:text-black">

