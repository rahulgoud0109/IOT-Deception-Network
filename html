      document.getElementById('dpi-pkt-id').innerText = `Packet #${pkt.id} [${pkt.proto}]`;
      document.getElementById('dpi-ip').innerText = `Src: ${pkt.src} -> Dst: ${pkt.dst}`;
      document.getElementById('dpi-proto').innerText = `${pkt.proto} (Port ${pkt.port}) Size=${pkt.size}B`;
      document.getElementById('dpi-hex').innerText = pkt.hexPayload;
      document.getElementById('dpi-anomaly-score').innerText = pkt.isAnomaly ? 'Anomaly Confidence: 96%' : 'Anomaly Confidence: 2%';
      document.getElementById('dpi-summary').innerText = pkt.isAnomaly 
        ? 'Deep Packet Inspection identified unauthorized brute-force shell attempt on IoT honeypot service.' 
        : 'Standard telemetry heartbeat payload matching benign device specification.';
    }

    /* ==========================================================================
       6. SIEM & INCIDENT MANAGEMENT
       ========================================================================== */
    function renderSiemTable() {
      const tbody = document.getElementById('siem-table-body');
      if (!tbody) return;

      tbody.innerHTML = attackLogs.map(log => `
        <tr class="border-b border-slate-800/60 hover:bg-slate-900/50">
          <td class="p-3 text-cyan-400 font-bold">${log.id}</td>
          <td class="p-3 text-slate-400">${log.time}</td>
          <td class="p-3">
            <span class="px-2 py-0.5 text-xs font-bold ${log.severity === 'CRITICAL' ? 'bg-rose-500/20 text-rose-400 border border-rose-500/30' : log.severity === 'WARNING' ? 'bg-amber-500/20 text-amber-400 border border-amber-500/30' : 'bg-cyan-500/20 text-cyan-400'} rounded">
              ${log.severity}
            </span>
          </td>
          <td class="p-3 text-slate-200">${log.type}</td>
          <td class="p-3 text-rose-400 font-mono">${log.ip}</td>
          <td class="p-3 text-slate-300">${log.target}</td>
          <td class="p-3"><span class="px-2 py-0.5 bg-emerald-500/10 text-emerald-400 rounded">${log.action}</span></td>
          <td class="p-3">
            <button onclick="openSiemModal('${log.id}')" class="px-2.5 py-1 bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-300 rounded text-xs transition">
              Investigate
            </button>
          </td>
        </tr>
      `).join('');

      // Also update dashboard feed table
      const dashBody = document.getElementById('dash-feed-body');
      if (dashBody) {
        dashBody.innerHTML = attackLogs.slice(0, 5).map(log => `
          <tr class="hover:bg-slate-900/50">
            <td class="p-3 text-slate-400">${log.time}</td>
            <td class="p-3 text-rose-400 font-bold">${log.ip}</td>
            <td class="p-3 text-slate-300">${log.target}</td>
            <td class="p-3 text-slate-400">${log.service}</td>
            <td class="p-3 text-slate-200">${log.type}</td>
            <td class="p-3"><span class="px-2 py-0.5 text-xs ${log.severity === 'CRITICAL' ? 'bg-rose-500/20 text-rose-400' : 'bg-amber-500/20 text-amber-400'} rounded">${log.severity}</span></td>
            <td class="p-3 text-emerald-400">${log.action}</td>
          </tr>
        `).join('');
      }
    }

    let currentSiemLogId = null;

    function openSiemModal(logId) {
      currentSiemLogId = logId;
      const log = attackLogs.find(l => l.id === logId);
      if (!log) return;

      document.getElementById('siem-modal').classList.remove('hidden');
      document.getElementById('siem-modal-title').innerText = `Incident Investigation #${log.id}`;
      document.getElementById('siem-modal-ip').innerText = log.ip;
      document.getElementById('siem-modal-node').innerText = log.target;
      document.getElementById('siem-modal-vector').innerText = log.type;
      document.getElementById('siem-modal-payload').innerText = log.payload;
    }

    function closeSiemModal() {
      document.getElementById('siem-modal').classList.add('hidden');
    }

    function executeIpBan() {
      if (!currentSiemLogId) return;
      const log = attackLogs.find(l => l.id === currentSiemLogId);
      if (log) {
        log.action = 'IP Blacklisted in Firewall';
        renderSiemTable();
        alert(`Source IP [${log.ip}] has been blacklisted across the IoT Deception Network.`);
        closeSiemModal();
      }
    }

    function filterSiemEvents() {
      renderSiemTable();
    }

    /* ==========================================================================
       THEME PREFERENCE
       ========================================================================== */
    function applyTheme(theme) {
      const isLight = theme === 'light';
      document.body.classList.toggle('theme-light', isLight);
      document.documentElement.classList.toggle('dark', !isLight);
      document.documentElement.classList.toggle('light', isLight);

      const icon = document.getElementById('theme-icon');
      const label = document.getElementById('theme-label');
      const toggle = document.getElementById('theme-toggle');
      if (icon) icon.className = `fa-solid ${isLight ? 'fa-moon' : 'fa-sun'} theme-icon`;
      if (label) label.innerText = isLight ? 'Dark' : 'Light';
      if (toggle) {
        toggle.title = isLight ? 'Switch to dark theme' : 'Switch to light theme';
        toggle.setAttribute('aria-label', toggle.title);
      }

      localStorage.setItem('iot-soc-theme', theme);
      updateChartTheme(isLight);
    }

    function toggleTheme() {
      const next = document.body.classList.contains('theme-light') ? 'dark' : 'light';
      applyTheme(next);
    }

    function updateChartTheme(isLight) {
      const text = isLight ? '#475569' : '#94a3b8';
      const grid = isLight ? 'rgba(15,23,42,0.08)' : 'rgba(255,255,255,0.05)';
      [trafficChartInstance, honeypotBarChartInstance].forEach(chart => {
        if (!chart) return;
        if (chart.options.scales) {
          Object.values(chart.options.scales).forEach(scale => {
            if (scale.ticks) scale.ticks.color = text;
            if (scale.grid) scale.grid.color = grid;
          });
        }
        if (chart.options.plugins?.legend?.labels) chart.options.plugins.legend.labels.color = text;
        chart.update('none');
      });
    }

    function initializeTheme() {
      const saved = localStorage.getItem('iot-soc-theme');
      const preferred = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      applyTheme(preferred);
    }

    /* ==========================================================================
       7. INTERACTIVE ATTACK SIMULATOR & LOOP
       ========================================================================== */
    function triggerAttackScenario(type) {
      totalThreats += 1;
      document.getElementById('kpi-threat-count').innerText = totalThreats;

      let newLog = null;
      if (type === 'PORT_SCAN') {
        newLog = {
          id: `INC-${Math.floor(8900 + Math.random() * 1000)}`,
          time: new Date().toTimeString().split(' ')[0],
          ip: '103.251.167.8',
          target: 'All Deception Nodes',
          service: 'Multi-Port (21-8080)',
          type: 'Nmap TCP SYN Sweep',
          severity: 'WARNING',
          action: 'Honeypot Trap Triggered',
          payload: 'SYN SCAN [Ports 21, 22, 23, 80, 554, 1883]'
        };
      } else if (type === 'BRUTE_FORCE') {
        newLog = {
          id: `INC-${Math.floor(8900 + Math.random() * 1000)}`,
          time: new Date().toTimeString().split(' ')[0],
          ip: '185.220.101.5',
          target: 'Smart Camera (192.168.1.101)',
          service: 'Telnet (23)',
          type: 'Telnet Credential Spray',
          severity: 'CRITICAL',
          action: 'Captured & Quarantined',
          payload: 'AUTH TRY: admin/admin, root/root, support/support'
        };
        // Highlight camera node
        const camera = iotNodes.find(n => n.id === 'node-1');
        if (camera) {
          camera.status = 'attack';
          camera.trapped += 5;
          renderNodes();
          setTimeout(() => { camera.status = 'active'; renderNodes(); }, 5000);
        }
      } else if (type === 'MIRAI') {
        newLog = {
          id: `INC-${Math.floor(8900 + Math.random() * 1000)}`,
          time: new Date().toTimeString().split(' ')[0],
          ip: '45.142.214.12',
          target: 'Core IoT Router (192.168.1.1)',
          service: 'HTTP / Telnet',
          type: 'Mirai Botnet Probe',
          severity: 'CRITICAL',
          action: 'Payload Captured',
          payload: '/bin/busybox MIRAI_ARM7_PROPAGATION_VECTOR'
        };
      } else if (type === 'UDP_FLOOD') {
        newLog = {
          id: `INC-${Math.floor(8900 + Math.random() * 1000)}`,
          time: new Date().toTimeString().split(' ')[0],
          ip: '198.51.100.44',
          target: 'Industrial Gateway (192.168.1.200)',
          service: 'UDP Multi-Port',
          type: 'UDP Flood Traffic Anomaly',
          severity: 'CRITICAL',
          action: 'Rate Limiter Engaged',
          payload: 'UDP Packet Spike > 1000 pkts/sec'
        };
      } else if (type === 'NORMAL_BURST') {
        for (let i = 0; i < 5; i++) {
          addPacketToStream(generateRandomPacket());
        }
        alert('Injecting normal benign IoT telemetry traffic pulse.');
        return;
      }

      if (newLog) {
        attackLogs.unshift(newLog);
        renderSiemTable();
        
        // Add matching malicious packet to sniffer
        addPacketToStream({
          id: packetStream.length + 1,
          time: newLog.time,
          src: newLog.ip,
          dst: '192.168.1.101',
          proto: 'TCP',
          port: 23,
          size: 512,
          isAnomaly: true,
          flag: 'CRITICAL_THREAT',
          hexPayload: '0000  53 59 53 54 45 4d 20 41 54 54 41 43 4b 20 46 49  SYSTEM ATTACK FI\n0010  52 45 44 20 42 59 20 53 49 4d 55 4c 41 54 4f 52  RED BY SIMULATOR'
        });

        switchTab('dashboard');
      }
    }

    function toggleSimulation() {
      isSimulating = !isSimulating;
      const btn = document.getElementById('toggle-sim-btn');
      const icon = document.getElementById('sim-icon');
      const text = document.getElementById('sim-text');

      if (isSimulating) {
        icon.className = 'fa-solid fa-pause';
        text.innerText = 'Pause Engine';
        btn.classList.replace('bg-emerald-500/20', 'bg-cyan-500/20');
      } else {
        icon.className = 'fa-solid fa-play';
        text.innerText = 'Resume Engine';
        btn.classList.replace('bg-cyan-500/20', 'bg-emerald-500/20');
      }
    }

    /* Simulation Background Loop */
    setInterval(() => {
      if (!isSimulating) return;

      // Update counters
      packetCounter += Math.floor(Math.random() * 5 + 1);
      document.getElementById('kpi-total-packets').innerText = packetCounter.toLocaleString();
      document.getElementById('header-pkt-count').innerText = packetCounter.toLocaleString();

      // Push new random packet
      const pkt = generateRandomPacket();
      addPacketToStream(pkt);

      // Randomly bump chart
      if (trafficChartInstance) {
        const datasets = trafficChartInstance.data.datasets;
        datasets[0].data.shift();
        datasets[0].data.push(Math.floor(Math.random() * 20 + 45));

        datasets[1].data.shift();
        datasets[1].data.push(pkt.isAnomaly ? Math.floor(Math.random() * 30 + 30) : Math.floor(Math.random() * 10));

        trafficChartInstance.update('none');
      }
    }, 1500);

    /* ==========================================================================
       8. ONLOAD BOOTSTRAP
       ========================================================================== */
    window.onload = function() {
      initializeTheme();
      initCharts();
      renderNodes();
      
      // Populate initial packet stream
      for (let i = 0; i < 15; i++) {
        packetStream.push(generateRandomPacket());
      }
      renderSnifferTable();
      renderSiemTable();
      updateChartTheme(document.body.classList.contains('theme-light'));
    };
  </script>
