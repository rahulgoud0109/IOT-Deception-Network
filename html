    function generateRandomPacket() {
      const protocols = ['TCP', 'UDP', 'MQTT', 'Telnet', 'HTTP'];
      const ips = ['185.220.101.5', '45.142.214.12', '103.251.167.8', '192.168.1.101', '192.168.1.102', '192.168.1.1'];
      const isAnomaly = Math.random() < 0.25;

      const proto = protocols[Math.floor(Math.random() * protocols.length)];
      const src = ips[Math.floor(Math.random() * ips.length)];
      const dst = '192.168.1.' + Math.floor(Math.random() * 5 + 100);
      const port = proto === 'Telnet' ? 23 : proto === 'MQTT' ? 1883 : proto === 'HTTP' ? 80 : Math.floor(Math.random() * 8000 + 1000);
      const size = Math.floor(Math.random() * 800 + 64);
      const now = new Date();
      const timestamp = now.toTimeString().split(' ')[0] + '.' + String(now.getMilliseconds()).padStart(3, '0');

      return {
        id: packetStream.length + 1,
        time: timestamp,
        src: src,
        dst: dst,
        proto: proto,
        port: port,
        size: size,
        isAnomaly: isAnomaly,
        flag: isAnomaly ? 'ANOMALY_DETECTED' : 'SYN_ACK',
        hexPayload: isAnomaly 
          ? '0000  41 44 4d 49 4e 3a 41 44 4d 49 4e 0d 0a 53 59 53  ADMIN:ADMIN..SYS\n0010  54 58 45 43 20 2f 62 69 6e 2f 73 68 20 2d 69 00  EXEC /bin/sh -i.'
          : '0000  10 1a 00 04 4d 51 54 54 04 02 00 3c 00 0c 73 6d  ....MQTT...<..sm\n0010  61 72 74 2d 62 75 6c 62 2d 30 31 00 00 00 00 00  art-bulb-01.....'
      };
    }

    function addPacketToStream(pkt) {
      packetStream.unshift(pkt);
      if (packetStream.length > 50) packetStream.pop();
      renderSnifferTable();
    }

    function renderSnifferTable() {
      const tbody = document.getElementById('packet-table-body');
      if (!tbody) return;

      const filterProto = document.getElementById('filter-proto').value;
      const filterAnomaly = document.getElementById('filter-anomaly').value;
      const search = document.getElementById('filter-search').value.toLowerCase();

      const filtered = packetStream.filter(p => {
        if (filterProto !== 'ALL' && p.proto !== filterProto) return false;
        if (filterAnomaly === 'ANOMALY' && !p.isAnomaly) return false;
        if (filterAnomaly === 'NORMAL' && p.isAnomaly) return false;
        if (search && !p.src.includes(search) && !p.dst.includes(search) && !String(p.port).includes(search)) return false;
        return true;
      });

      tbody.innerHTML = filtered.map(p => `
        <tr onclick="inspectPacket(${p.id})" class="packet-row cursor-pointer border-b border-slate-800/40 hover:bg-slate-800/50">
          <td class="p-2.5 text-slate-500">#${p.id}</td>
          <td class="p-2.5 text-slate-300">${p.time}</td>
          <td class="p-2.5 font-mono ${p.isAnomaly ? 'text-rose-400 font-bold' : 'text-slate-300'}">${p.src}</td>
          <td class="p-2.5 font-mono text-slate-300">${p.dst}</td>
          <td class="p-2.5"><span class="px-1.5 py-0.5 bg-slate-800 rounded text-cyan-300 text-xs">${p.proto}</span></td>
          <td class="p-2.5 text-slate-400">${p.port}</td>
          <td class="p-2.5 text-slate-400">${p.size} B</td>
          <td class="p-2.5">${p.isAnomaly 
            ? `<span class="px-2 py-0.5 bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded">SUSPICIOUS</span>` 
            : `<span class="px-2 py-0.5 bg-emerald-500/10 text-emerald-400 rounded">OK</span>`}</td>
        </tr>
      `).join('');
    }

